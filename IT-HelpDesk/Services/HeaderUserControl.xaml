<UserControl x:Class="IT_HelpDesk.Controls.HeaderUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="50">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Аватар и ФИО-->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
            <Ellipse Width="32" Height="32" Cursor="Hand" MouseLeftButtonUp="AvatarEllipse_MouseLeftButtonUp">
                <Ellipse.Fill>
                    <ImageBrush x:Name="AvatarBrush" ImageSource="/Data/Images/avatar.jpg" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="FullNameText" Text="{Binding DisplayName, FallbackValue='Пользователь'}" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Расстояние между ФИО и кнопками -->
        <Grid Grid.Column="1"/>

        <!-- Кнопки -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
            <Button x:Name="NotificationsButton" Width="32" Height="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Click="NotificationsButton_Click" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_Notifications]}">
                <Grid>
                    <TextBlock Text="🔔" FontSize="20"/>
                    <Border x:Name="NotificationBadge" Background="Red" CornerRadius="10" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Visibility="Collapsed">
                        <TextBlock x:Name="BadgeText" Text="0" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Button>
            <Button x:Name="LanguageButton" Width="32" Height="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Click="LanguageButton_Click" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[ChangeLanguage_tooltip]}">
                <TextBlock Text="🌐" FontSize="20"/>
            </Button>
            <Button x:Name="LogoutButton" Width="32" Height="32" Cursor="Hand" Background="Transparent" BorderThickness="0" Click="LogoutButton_Click" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_Logout]}">
                <TextBlock Text="❌" FontSize="20" Foreground="Red"/>
            </Button>
        </StackPanel>

        <!-- Popup уведомлений -->
        <Popup x:Name="NotificationsPopup" PlacementTarget="{Binding ElementName=NotificationsButton}" Placement="Bottom" StaysOpen="False">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Width="350" MaxHeight="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10,5,10,5">
                        <TextBlock Text="Уведомления" FontWeight="Bold" FontSize="14"/>
                        <Button x:Name="MarkAllReadButton" Content="Прочитать все" HorizontalAlignment="Right" Width="100" Height="25" Click="MarkAllReadButton_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="NotificationsItemsControl" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8" Cursor="Hand" MouseLeftButtonUp="NotificationItem_Click">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="{Binding IsRead, Converter={StaticResource ReadToFontWeightConverter}}"/>
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM HH:mm'}" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoNotificationsTextBlock" Text="{Binding Source={StaticResource LocalizationManager}, Path=[NoNotifications_Label]}" FontSize="14" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                    <Button x:Name="LoadMoreButton" Grid.Row="2" Content="Загрузить ещё" Margin="10,5,10,10" Click="LoadMoreButton_Click" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>