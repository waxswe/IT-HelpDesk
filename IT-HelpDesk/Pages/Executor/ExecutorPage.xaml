<Page x:Class="IT_HelpDesk.Pages.Executor.ExecutorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IT_HelpDesk.Pages.Executor"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Страница исполнителя">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Width="1000" Height="450" Grid.Column="1">
            <Border Width="1000" Height="450" CornerRadius="25" Background="#30A6C9" BorderBrush="#000000" BorderThickness="1"/>

            <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Executor_Title]}" Margin="0,10,0,0" FontSize="24" VerticalAlignment="Top"/>

            <!-- Поиск и фильтры -->
            <Grid x:Name="SearchFilterPanel" Panel.ZIndex="1" Width="800" Height="25" Margin="30,55,30,0" VerticalAlignment="Top">
                <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#000000"/>
                <TextBox x:Name="TBSearch" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Margin="0,0,80,0" VerticalContentAlignment="Center" Width="600" Height="25">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Text="🔍" FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" MouseLeftButtonUp="SearchIcon_Click" Cursor="Hand"/>
                <Image x:Name="FilterImg" Source="/Data/Images/filter.png" Width="20" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" MouseLeftButtonUp="FilterImg_MouseLeftButtonUp" Cursor="Hand"/>
                <Popup x:Name="FilterMenu" PlacementTarget="{Binding ElementName=FilterImg}" Placement="Bottom" StaysOpen="False">
                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="10" Width="200">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[Filter_Status_Active_Executor]}" FontWeight="Bold"/>
                            <MenuItem x:Name="FilterStatusInWork" Header="{Binding Source={StaticResource LocalizationManager}, Path=[Filter_Status_InWork]}" IsCheckable="True" Click="FilterOption_Click"/>
                            <MenuItem x:Name="FilterStatusWaiting" Header="{Binding Source={StaticResource LocalizationManager}, Path=[Filter_Status_WaitingExecutor]}" IsCheckable="True" Click="FilterOption_Click"/>
                            <Separator Margin="0,5"/>
                            <Button Content="{Binding Source={StaticResource LocalizationManager}, Path=[Filter_Reset_Manager]}" Click="ResetFilters_Click" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Счетчики заявок по статусам -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,90,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="TotalCountText" Foreground="White" Margin="0,0,15,0"/>
                <TextBlock x:Name="AssignedCountText" Foreground="White" Margin="0,0,15,0"/>
                <TextBlock x:Name="InWorkCountText" Foreground="White" Margin="0,0,15,0"/>
                <TextBlock x:Name="WaitingCountText" Foreground="White"/>
            </StackPanel>

            <TextBlock x:Name="NoRequestsTextBlock" Text="{Binding Source={StaticResource LocalizationManager}, Path=[NoRequests_Placeholder]}" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

            <ScrollViewer Margin="30,130,30,50" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RequestsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Margin="0,0,0,10" Padding="0,0,0,8"
                                    MouseLeftButtonUp="Request_MouseLeftButtonUp" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="300"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Левая часть -->
                                    <StackPanel Grid.Column="0" Margin="0,0,15,0" HorizontalAlignment="Left">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding RequestNumber}" Grid.Column="0" Foreground="#444444" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding Category}" Grid.Column="1" Foreground="#444444" FontWeight="SemiBold" Margin="0,0,25,0"/>
                                            <TextBlock Text="{Binding Title}" Grid.Column="2" Foreground="#444444" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" Foreground="White" Margin="0,5,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="450" HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <!-- Правая часть -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <!-- Статус -->
                                        <StackPanel Orientation="Vertical" MinWidth="90" Margin="15,0,15,0">
                                            <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[Status_Label_Client]}" Foreground="#444444" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusName}" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Последнее обновление -->
                                        <StackPanel Orientation="Vertical" MinWidth="110" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[Last_Update_Label_Client]}" Foreground="#444444" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LastResponse}" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Дата создания -->
                                        <StackPanel Orientation="Vertical" MinWidth="110" Margin="0,0,15,0">
                                            <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[Created_Label_Client]}" Foreground="#444444" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding CreatedAt}" Foreground="White" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <!-- Кнопка "Завершить" -->
                                        <Border Width="85" Margin="5,0,0,0">
                                            <Button Content="{Binding Source={StaticResource LocalizationManager}, Path=[Complete_Button]}" Width="85" Height="30"
                                                    Click="CompleteButton_Click" Tag="{Binding RequestObject}"
                                                    VerticalAlignment="Center" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Complete_Button]}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Пагинация -->
            <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20">
                <Button x:Name="PrevPageButton" Content="&lt;" Width="30" Height="30" Margin="5" Click="PrevPage_Click" IsEnabled="False"/>
                <TextBlock x:Name="PageInfo" Text="Страница 1/1" VerticalAlignment="Center" Margin="10,0" Foreground="White"/>
                <Button x:Name="NextPageButton" Content="&gt;" Width="30" Height="30" Margin="5" Click="NextPage_Click" IsEnabled="False"/>
                <TextBox x:Name="TBPageNumber" Width="40" Height="25" Margin="10,0,5,0" TextAlignment="Center" KeyDown="TBPageNumber_KeyDown" Background="White" Foreground="Black" Text="1" PreviewTextInput="TBPageNumber_PreviewTextInput"/>
                <Button Content="{Binding Source={StaticResource LocalizationManager}, Path=[GoTo_Button]}" Width="60" Height="25" Margin="0,0,5,0" Click="GoToPageButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
