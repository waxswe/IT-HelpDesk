<Page x:Class="IT_HelpDesk.Pages._General.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IT_HelpDesk.Pages._General"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      KeyDown="Page_KeyDown"
      Title="Авторизация">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Auth_Title]}" FontSize="32" Margin="10"/>
            <StackPanel Orientation="Horizontal">
                <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Login_Label]}" HorizontalAlignment="Left" Margin="35,0,0,0"/>
                <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
            </StackPanel>
            <TextBox x:Name="TBLogin" Margin="0,0,0,10" FontSize="22" TabIndex="1" MaxLength="16"/>

            <StackPanel Orientation="Horizontal">
                <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Password_Label]}" HorizontalAlignment="Left" Margin="35,0,0,0"/>
                <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
            </StackPanel>
            <DockPanel Height="50" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="40,0,0,10">
                <PasswordBox x:Name="PBPassword" FontSize="22" TabIndex="2"/>
                <TextBlock x:Name="EyeIcon" Text="👁" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,10,0" Cursor="Hand" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Password_Tooltip]}" 
                           MouseEnter="EyeIcon_MouseEnter" MouseLeave="EyeIcon_MouseLeave" Grid.Column="2" Grid.Row="3"/>
            </DockPanel>

            <Button Style="{StaticResource LinkButtonStyle}" Content="{Binding Source={StaticResource LocalizationManager}, Path=[ForgotPassword_Button]}" Click="ForgotPassword_Click" TabIndex="4" HorizontalAlignment="Right" Margin="0,0,40,0"/>

            <CheckBox x:Name="RememberMeCheckBox" Content="{Binding Source={StaticResource LocalizationManager}, Path=[RememberMe_Checkbox]}" Margin="40,10,0,0"/>

            <Button Content="{Binding Source={StaticResource LocalizationManager}, Path=[Login_Button]}" Margin="0,30,0,0" x:Name="EnterButton" Click="EnterButton_Click" TabIndex="3"/>
        </StackPanel>
        <Button x:Name="LanguageButton" Content="🌐" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20" Click="LanguageButton_Click" Background="AliceBlue" 
                Height="30" Width="30" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[ChangeLanguage_tooltip]}" BorderBrush="White">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🇷🇺 Русский" Click="SetRussian_Click"/>
                    <MenuItem Header="🇬🇧 English" Click="SetEnglish_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
</Page>
