<Page x:Class="IT_HelpDesk.Pages._General.RequestCommentaries"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:IT_HelpDesk.Pages._General"
      mc:Ignorable="d" 
      d:DesignHeight="520" d:DesignWidth="1280"
      Title="Комментарии к обращению"
      Background="Transparent"
      KeyDown="Page_KeyDown">

    <Page.Resources>
        <!-- Шаблон для чужих комментариев (аватар слева) -->
        <DataTemplate x:Key="OtherCommentTemplate">
            <Border Margin="0,0,0,12" Padding="10" Background="{Binding BackgroundColor}" 
                    CornerRadius="10" BorderBrush="#000000" BorderThickness="1"
                    HorizontalAlignment="Left" MaxWidth="620">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Margin="0,0,10,0" Cursor="Hand"
                            MouseLeftButtonUp="Avatar_MouseLeftButtonUp" Tag="{Binding UserID}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="10" Padding="10" Margin="0,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding AuthorName}" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding AuthorRole}" Foreground="Gray" Margin="0,0,12,0" FontSize="11"/>
                                <TextBlock Text="{Binding CreatedAt}" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding EditedIndicator}" Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Шаблон для своих комментариев (аватар справа, кнопки внизу) -->
        <DataTemplate x:Key="OwnCommentTemplate">
            <Border Margin="0,0,0,12" Padding="10" Background="{Binding BackgroundColor}" 
                    CornerRadius="10" BorderBrush="#000000" BorderThickness="1"
                    HorizontalAlignment="Right" MaxWidth="620">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="#E1F5FE" CornerRadius="10" Padding="10" Margin="0,0,10,5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding EditedIndicator}" Foreground="Gray" FontSize="11" FontStyle="Italic" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding CreatedAt}" Foreground="Gray" FontSize="11"/>
                                <TextBlock Text="{Binding AuthorRole}" Foreground="Gray" Margin="12,0,12,0" FontSize="11"/>
                                <TextBlock Text="{Binding AuthorName}" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="38" Height="38" CornerRadius="19" Margin="0,0,0,0" Cursor="Hand" MouseLeftButtonUp="Avatar_MouseLeftButtonUp" Tag="{Binding UserID}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,10,0" Visibility="{Binding ActionsVisibility}">
                        <Button Width="24" Height="24" Margin="3" Background="Transparent" BorderThickness="0" Click="EditComment_Click" Tag="{Binding CommentID}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Edit_Button_Tooltip]}">
                            <TextBlock Text="✏️" FontSize="12"/>
                        </Button>
                        <Button Width="24" Height="24" Margin="3" Background="Transparent" BorderThickness="0" Click="DeleteComment_Click" Tag="{Binding CommentID}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Delete_Button_Tooltip]}">
                            <TextBlock Text="❌" FontSize="12" Foreground="Red"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Шаблон для системного уведомления -->
        <DataTemplate x:Key="SystemCommentTemplate">
            <Border Margin="0,0,0,12" Padding="10" Background="#FFF9C4" CornerRadius="10" BorderBrush="#AAAAAA" BorderThickness="1" HorizontalAlignment="Center" MaxWidth="500">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" TextAlignment="Center" FontStyle="Italic"/>
                    <TextBlock Text="{Binding CreatedAt}" Foreground="Gray" FontSize="10" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:CommentTemplateSelector x:Key="CommentTemplateSelector" OwnCommentTemplate="{StaticResource OwnCommentTemplate}" OtherCommentTemplate="{StaticResource OtherCommentTemplate}" SystemCommentTemplate="{StaticResource SystemCommentTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель с заголовком и кнопкой закрытия -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleTextBlock" Grid.Column="1" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Source={StaticResource LocalizationManager}, Path=[Comments_Title_Com], StringFormat='{}{0}'}"/>
                <Button Grid.Column="2" Width="32" Height="32" Background="Transparent" BorderThickness="0" Click="CloseButton_Click" ToolTip="Закрыть">
                    <TextBlock Text="❌" FontSize="16"/>
                </Button>
            </Grid>

            <!-- Список комментариев -->
            <ScrollViewer x:Name="CommentsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <Grid>
                    <ItemsControl x:Name="CommentsItemsControl" ItemTemplateSelector="{StaticResource CommentTemplateSelector}" Visibility="Collapsed"/>
                    <TextBlock x:Name="NoCommentsTextBlock" Text="{Binding Source={StaticResource LocalizationManager}, Path=[NoCommentsYet]}" FontSize="16" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>

            <!-- Поле ввода -->
            <Grid Grid.Row="2" HorizontalAlignment="Center" Width="400">
                <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#000000"/>
                <TextBox x:Name="CommentTextBox" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Margin="10,5,45,5" MinHeight="32" MaxHeight="80" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Comment_Input_Placeholder]}" Padding="2">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button x:Name="SendButton" Width="32" Height="32" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SendButton_Click" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Send_Button_Tooltip]}">
                    <Image Source="/Data/Images/send.png" Width="20" Height="20" Margin="0,0,0,5"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>