<Page x:Class="IT_HelpDesk.Pages.Administrator.AddEditUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IT_HelpDesk.Pages.Administrator"
      xmlns:classes="clr-namespace:IT_HelpDesk.Data.Classes"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Добавить пользователя">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Фоновый прямоугольник -->
        <Grid Width="950" Height="450" Margin="0,0,0,0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="150*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="250*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="250*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="200*"/>
                <RowDefinition Height="200*"/>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="100*"/>
            </Grid.RowDefinitions>
            <Border Width="950" Height="450" CornerRadius="25" Background="#30A6C9" BorderBrush="#000000" BorderThickness="1" Grid.RowSpan="11" Grid.ColumnSpan="5"/>
            <Label x:Name="AddUserLabel" Content="{Binding Source={StaticResource LocalizationManager}, Path=[Add_User]}" FontSize="24" Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"/>

            <StackPanel HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Add_Login_Label]}" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
                </StackPanel>
                <TextBox x:Name="TBLogin" Text="{Binding login}" Width="350" Height="35" MaxLength="16"/>
            </StackPanel>
            
            <StackPanel HorizontalAlignment="Right" Grid.Row="3" Grid.Column="3" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Add_Password_Label]}" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Width="450">
                    <PasswordBox x:Name="PBPassword" PasswordChar="*" Width="350" Height="35" Visibility="Visible"/>
                    <TextBox x:Name="TBPasswordReveal" Text="" IsReadOnly="True" Width="350" Height="35" Visibility="Collapsed" BorderThickness="1"/>
                    <TextBlock x:Name="EyeIcon" Text="👁" FontSize="16" Cursor="Hand" Margin="5,0,0,0" VerticalAlignment="Center" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Password_Tooltip]}" Width="20" TextAlignment="Center" MouseEnter="EyeIcon_MouseEnter" MouseLeave="EyeIcon_MouseLeave"/>
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left" Grid.Row="5" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[FullName_Label]}" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
                </StackPanel>
                <TextBox x:Name="TBFullname" Text="{Binding name}" Width="350" Height="35" MaxLength="64"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Grid.Row="5" Grid.Column="3">
                <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Email_Label]}" HorizontalAlignment="Left"/>
                <TextBox x:Name="TBEmail" Text="{Binding email}" Width="350" Height="35" MaxLength="64"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left" Grid.Row="7" Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Role_Label]}" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
                </StackPanel>
                <ComboBox x:Name="CBRole" SelectedValue="{Binding roleID}" SelectedValuePath="RoleID" DisplayMemberPath="LocalizedName" Width="350" Height="30"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left" Grid.Row="8" Grid.Column="1" x:Name="ProfessionPanel" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" x:Name="ProfessionPanelLabel"  Visibility="Collapsed">
                    <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Profession_Label]}" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ProfessionStar" Style="{StaticResource RequiredStar}" Visibility="Collapsed" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
                </StackPanel>
                <ComboBox x:Name="CBProfession" SelectedValue="{Binding professionID}" SelectedValuePath="ProfessionID" DisplayMemberPath="LocalizedName" Height="30"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Grid.Row="7" Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[Status_Label]}" HorizontalAlignment="Left"/>
                    <TextBlock Style="{StaticResource RequiredStar}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[RequiredField_Tooltip]}"/>
                </StackPanel>
                <ComboBox x:Name="CBStatus" SelectedValue="{Binding statusID}" SelectedValuePath="StatusID" DisplayMemberPath="LocalizedName" Width="350" Height="30"/>
            </StackPanel>

            <Button x:Name="SaveChangesButton" Content="{Binding Source={StaticResource LocalizationManager}, Path=[Save_Button]}" Click="SaveChangesButton_Click" Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="3"/>
        </Grid>

        <Button x:Name="CancelButton" Content="{Binding Source={StaticResource LocalizationManager}, Path=[Back_Button]}" Click="CancelButton_Click" Grid.Row="9" Grid.Column="2" HorizontalAlignment="Center"/>
    </Grid>
</Page>