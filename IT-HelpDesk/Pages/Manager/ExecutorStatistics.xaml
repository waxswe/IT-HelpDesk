<Page x:Class="IT_HelpDesk.Pages.Manager.ExecutorStatistics"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IT_HelpDesk.Pages.Manager"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Статистика исполнителей">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Фоновый прямоугольник -->
        <Grid Width="950" Height="450" Grid.Column="1">
            <Border Width="950" Height="450" CornerRadius="25" Background="#30A6C9" BorderBrush="#000000" BorderThickness="1"/>
            <Label Content="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Title]}" Margin="0,10,0,0" FontSize="24" VerticalAlignment="Top"/>

            <!-- Выбор периода -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,50,0,0" VerticalAlignment="Top">
                <RadioButton x:Name="PeriodCurrentMonth" Content="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorReport_Period_CurrentMonth]}" 
                 GroupName="Period" Margin="15,0" VerticalAlignment="Center" IsChecked="True" Checked="Period_Changed"/>
                <RadioButton x:Name="PeriodPreviousMonth" Content="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorReport_Period_PreviousMonth]}" 
                 GroupName="Period" Margin="15,0" VerticalAlignment="Center" IsChecked="False" Checked="Period_Changed"/>
                <RadioButton x:Name="PeriodAllTime" Content="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorReport_Period_AllTime]}" 
                 GroupName="Period" Margin="15,0" VerticalAlignment="Center" IsChecked="False" Checked="Period_Changed"/>
            </StackPanel>

            <!-- Заголовки таблицы -->
            <Border Background="Transparent" Padding="0,0,0,5" Margin="30,90,0,0">
                <Grid HorizontalAlignment="Stretch" Cursor="Hand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_FullName]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_FullName]}" 
                               FontWeight="Bold" Foreground="Black" MouseLeftButtonUp="Header_Click" Tag="FullName"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_Profession]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_Profession]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="1" MouseLeftButtonUp="Header_Click" Tag="Profession"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_Total]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_TotalRequests]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="2" TextAlignment="Center" MouseLeftButtonUp="Header_Click" Tag="TotalRequests"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_Assigned]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_Assigned]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="3" TextAlignment="Center" MouseLeftButtonUp="Header_Click" Tag="AssignedRequests"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_InProgress]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_InProgress]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="4" TextAlignment="Center" MouseLeftButtonUp="Header_Click" Tag="InProgressRequests"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_Completed]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_Completed]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="5" TextAlignment="Center" MouseLeftButtonUp="Header_Click" Tag="CompletedRequests"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_CompletionPercent]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_CompletionPercent]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="6" TextAlignment="Center" MouseLeftButtonUp="Header_Click" Tag="CompletionPercent"/>
                    <TextBlock Text="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_Column_LoadPercent]}" ToolTip="{Binding Source={StaticResource LocalizationManager}, Path=[Tooltip_LoadPercent]}" 
                               FontWeight="Bold" Foreground="Black" Grid.Column="7" TextAlignment="Center" MouseLeftButtonUp="Header_Click" Tag="LoadPercent"/>
                </Grid>
            </Border>

            <!-- Список исполнителей с пагинацией -->
            <ScrollViewer Margin="30,120,30,50" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="StatisticsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Margin="0,0,0,5" Padding="0,5,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FullName}" Foreground="White" Grid.Column="0" Cursor="Hand" MouseLeftButtonUp="OpenUserProfile" Tag="{Binding UserID}"/>
                                    <TextBlock Text="{Binding Profession}" Foreground="White" Grid.Column="1"/>
                                    <TextBlock Text="{Binding TotalRequests}" Foreground="White" Grid.Column="2" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding AssignedRequests}" Foreground="White" Grid.Column="3" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding InProgressRequests}" Foreground="White" Grid.Column="4" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding CompletedRequests}" Foreground="White" Grid.Column="5" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding CompletionPercent}" Foreground="White" Grid.Column="6" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding LoadPercent}" Foreground="White" Grid.Column="7" TextAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Пагинация -->
            <StackPanel x:Name="PaginationPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,20">
                <Button x:Name="PrevPageButton" Content="{Binding Source={StaticResource LocalizationManager}, Path=[Prev_Button]}" Width="30" Height="30" Margin="5" Click="PrevPage_Click" IsEnabled="False"/>
                <TextBlock x:Name="PageInfo" Text="Страница 1/1" VerticalAlignment="Center" Margin="10,0" Foreground="White"/>
                <Button x:Name="NextPageButton" Content="{Binding Source={StaticResource LocalizationManager}, Path=[Next_Button]}" Width="30" Height="30" Margin="5" Click="NextPage_Click" IsEnabled="False"/>
                <TextBox x:Name="TBPageNumber" Width="40" Height="25" Margin="10,0,5,0" TextAlignment="Center" HorizontalContentAlignment="Center" 
                         KeyDown="TBPageNumber_KeyDown" Background="White" Foreground="Black" Text="1" PreviewTextInput="TBPageNumber_PreviewTextInput"/>
                <Button Content="{Binding Source={StaticResource LocalizationManager}, Path=[GoTo_Button]}" Width="60" Height="25" Margin="0,0,5,0" Click="GoToPageButton_Click"/>
            </StackPanel>

            <!-- если нет данных -->
            <TextBlock x:Name="NoDataTextBlock" Text="{Binding Source={StaticResource LocalizationManager}, Path=[NoData]}" 
                       FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="ExportButton" Content="{Binding Source={StaticResource LocalizationManager}, Path=[ExecutorStatistics_ExportButton]}" Margin="10" Click="ExportButton_Click"/>
            <Button x:Name="BackButton" Content="{Binding Source={StaticResource LocalizationManager}, Path=[Back_Button]}" Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
